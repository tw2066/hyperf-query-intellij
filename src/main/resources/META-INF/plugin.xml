<!--suppress PluginXmlValidity -->
<idea-plugin>
    <id>dev.ekvedaras.hyperfquery</id>
    <name>Hyperf Query</name>
    <vendor email="tw2066@163.com" url="https://github.com/tw2066">Mr.tang</vendor>

    <!-- Product and plugin compatibility requirements -->
    <!-- https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>
    <depends>com.intellij.database</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            parentId="reference.webide.settings.project.settings.php"
            id="preferences.ekvedaras.hyperfquery"
            displayName="Hyperf Query"
            nonDefaultProject="true"
            provider="dev.ekvedaras.hyperfquery.services.HyperfQuerySettingsConfigurableProvider"
            instance="dev.ekvedaras.hyperfquery.services.HyperfQuerySettingsConfigurable"/>
        <projectService
            serviceImplementation="dev.ekvedaras.hyperfquery.services.HyperfQuerySettings"/>
        <notificationGroup displayType="BALLOON" id="Hyperf Query Settings" isLogByDefault="true"/>
        <postStartupActivity implementation="dev.ekvedaras.hyperfquery.services.Startup" />

        <completion.contributor language="PHP"
                                implementationClass="dev.ekvedaras.hyperfquery.completion.IndexCompletionContributor"
                                order="first"/>
        <completion.contributor language="PHP"
                                implementationClass="dev.ekvedaras.hyperfquery.completion.TableOrViewCompletionContributor"
                                order="first"/>
        <completion.contributor language="PHP"
                                implementationClass="dev.ekvedaras.hyperfquery.completion.ColumnCompletionContributor"
                                order="first"/>
        <completion.contributor language="PHP"
                                implementationClass="dev.ekvedaras.hyperfquery.completion.CastTypeCompletionContributor"
                                order="first"/>
        <completion.contributor language="PHP"
                                implementationClass="dev.ekvedaras.hyperfquery.completion.ConnectionCompletionContributor"
                                order="first"/>
        <completion.contributor language="PHP"
                                implementationClass="dev.ekvedaras.hyperfquery.completion.BindingsCompletionContributor"
                                order="first"/>
        <completion.contributor language="PHP"
                                implementationClass="dev.ekvedaras.hyperfquery.completion.NewMigrationCompletionContributor"
                                order="last"/>

        <psi.referenceContributor language="PHP"
                                  implementation="dev.ekvedaras.hyperfquery.reference.IndexReferenceContributor"/>
        <psi.referenceContributor language="PHP"
                                  implementation="dev.ekvedaras.hyperfquery.reference.TableOrViewReferenceContributor"/>
        <psi.referenceContributor language="PHP"
                                  implementation="dev.ekvedaras.hyperfquery.reference.ColumnReferenceContributor"/>
        <psi.referenceContributor language="PHP"
                                  implementation="dev.ekvedaras.hyperfquery.reference.BindingsReferenceContributor"/>
        <psi.referenceContributor language="PHP"
                                  implementation="dev.ekvedaras.hyperfquery.reference.ConnectionReferenceContributor"/>

        <lang.documentationProvider language="PHP"
                                    order="first"
                                    implementationClass="dev.ekvedaras.hyperfquery.reference.ColumnDocumentationProvider"/>
        <lang.documentationProvider language="PHP"
                                    order="first"
                                    implementationClass="dev.ekvedaras.hyperfquery.reference.TableDocumentationProvider"/>

        <localInspection language="PHP"
                         groupPath="PHP"
                         groupKey="databaseGroupName"
                         shortName="UnknownTableOrViewInspection"
                         enabledByDefault="true"
                         bundle="messages.MyBundle"
                         key="unknownTableOrViewDisplayName"
                         implementationClass="dev.ekvedaras.hyperfquery.inspection.UnknownTableOrViewInspection"
        />
        <localInspection language="PHP"
                         groupPath="PHP"
                         groupKey="databaseGroupName"
                         shortName="UnknownColumnInspection"
                         enabledByDefault="true"
                         bundle="messages.MyBundle"
                         key="unknownColumnDisplayName"
                         implementationClass="dev.ekvedaras.hyperfquery.inspection.UnknownColumnInspection"
        />
        <localInspection language="PHP"
                         groupPath="PHP"
                         groupKey="databaseGroupName"
                         shortName="UnknownConnectionInspection"
                         enabledByDefault="true"
                         bundle="messages.MyBundle"
                         key="unknownConnectionDisplayName"
                         implementationClass="dev.ekvedaras.hyperfquery.inspection.UnknownConnectionInspection"
        />
    </extensions>

    <applicationListeners>
    </applicationListeners>
</idea-plugin>
